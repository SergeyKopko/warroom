# Leave VITE_WARROOM_GAME_ADDRESS empty to run the complete local demo.
VITE_WARROOM_GAME_ADDRESS=

# Optional production RPC. The public endpoint is used when omitted.
VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional start block for the Activity event indexer.
VITE_DEPLOYMENT_BLOCK=0

# Required only if you add WalletConnect in production.
VITE_WALLETCONNECT_PROJECT_ID=

# Deployment inputs. Put secrets only in an untracked local .env and never commit them.
WAR_TOKEN_ADDRESS=
TREASURY_ADDRESS=
ADMIN_ADDRESS=
PRIVATE_KEY=
PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
PLTR_TOKEN_ADDRESS=0x894E1EC2D74FFE5AEF8Dc8A9e84686acCB964F2A
